{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vett.r28.human_kit.bundle.schema.v1",
  "title": "R28 human verification bundles (public + gold)",
  "description": "Descriptive schema for bundle_public.json and bundle_gold.json produced by scripts/build_bundle.py. The public bundle must never contain answer-bearing material; the gold bundle is a separate file that is only loaded in the verification phase.",
  "oneOf": [
    {
      "type": "object",
      "required": ["schema", "kind", "kit_version", "items"],
      "properties": {
        "schema": {"const": "vett.r28.human_kit.bundle_public.v1"},
        "kind": {"const": "PUBLIC"},
        "kit_version": {"type": "string"},
        "generated_at_utc": {"type": "string"},
        "instructions_version": {"type": "string"},
        "items": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["item_id", "question_text", "ruleset", "documents"],
            "additionalProperties": false,
            "properties": {
              "item_id": {"type": "string"},
              "question_text": {"type": "string"},
              "ruleset": {
                "type": "object",
                "required": ["title", "effective_date"],
                "properties": {
                  "title": {"type": ["string", "null"]},
                  "effective_date": {"type": ["string", "null"]}
                }
              },
              "documents": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["document_id", "text", "spans"],
                  "properties": {
                    "document_id": {"type": "string"},
                    "genre": {"type": ["string", "null"]},
                    "text": {"type": "string"},
                    "spans": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": ["span_id", "text"],
                        "properties": {
                          "span_id": {"type": "string"},
                          "text": {"type": "string"},
                          "document_id": {"type": "string"},
                          "char_start": {"type": ["integer", "null"]},
                          "char_end": {"type": ["integer", "null"]},
                          "role": {"type": ["string", "null"]}
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "type": "object",
      "required": ["schema", "kind", "kit_version", "items"],
      "properties": {
        "schema": {"const": "vett.r28.human_kit.bundle_gold.v1"},
        "kind": {"const": "GOLD"},
        "kit_version": {"type": "string"},
        "generated_at_utc": {"type": "string"},
        "hidden_by_workflow": {"const": true},
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["item_id", "gold"],
            "properties": {
              "item_id": {"type": "string"},
              "gold": {
                "type": "object",
                "required": ["solver_facts", "decision_record_flat", "proof"],
                "properties": {
                  "solver_facts": {"type": "object"},
                  "decision_record_flat": {"type": "object"},
                  "proof": {
                    "type": "object",
                    "required": ["minimum_evidence_spans"],
                    "properties": {
                      "minimum_evidence_spans": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "object",
                          "required": ["span_id"],
                          "properties": {
                            "span_id": {"type": "string"},
                            "role": {"type": ["string", "null"]},
                            "document_id": {"type": ["string", "null"]},
                            "minimality": {"type": ["string", "null"]}
                          }
                        }
                      },
                      "rule_path": {"type": "array"},
                      "revision_chain": {"type": ["array", "object", "null"]},
                      "authority_decision": {"type": ["object", "null"]},
                      "why_not_distractor": {"type": "array"}
                    }
                  },
                  "meta": {"type": "object"}
                }
              }
            }
          }
        }
      }
    }
  ]
}
