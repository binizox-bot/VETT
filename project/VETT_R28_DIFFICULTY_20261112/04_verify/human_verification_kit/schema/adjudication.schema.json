{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "vett.r28.human_kit.adjudication.schema.v1",
  "title": "R28 adjudication rows",
  "description": "One JSON object per line, only for items/dimensions where annotators A and B disagree. A critical-negative final label must use attribution=GOLD_DEFECT; an UNDECIDABLE final label must use attribution=UNRESOLVED.",
  "type": "object",
  "required": ["schema", "kind", "adjudicator_id", "item_id", "dimension", "final_label", "attribution", "rationale"],
  "properties": {
    "schema": {"const": "vett.r28.human_kit.adjudication.v1"},
    "kind": {"const": "ADJUDICATION"},
    "kit_version": {"type": "string"},
    "adjudicator_id": {"type": "string", "minLength": 1},
    "item_id": {"type": "string"},
    "dimension": {"enum": ["value", "scope", "rule_version", "proof"]},
    "field": {"type": ["string", "null"]},
    "final_label": {"type": "string"},
    "attribution": {"enum": ["ANNOTATORS_AGREE", "A_ERROR", "B_ERROR", "BOTH_ERROR", "GOLD_DEFECT", "UNRESOLVED"]},
    "a_label": {"type": "string"},
    "b_label": {"type": "string"},
    "rationale": {"type": "string", "minLength": 1},
    "adjudicated_at_utc": {"type": "string"}
  }
}
