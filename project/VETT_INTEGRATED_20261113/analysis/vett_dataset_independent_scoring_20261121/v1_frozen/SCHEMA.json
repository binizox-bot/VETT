{
  "schema_version": "vett.dataset_scoring.freeze.v1",
  "model_inputs": {
    "format": "jsonl",
    "required": [
      "sample_id",
      "condition_code",
      "prompt",
      "prompt_sha256",
      "text_sha256",
      "field_order"
    ]
  },
  "predictions": {
    "format": "jsonl",
    "required": [
      "sample_id",
      "model",
      "raw_output"
    ],
    "optional": [
      "parsed"
    ]
  },
  "private_gold": {
    "format": "jsonl",
    "required": [
      "sample_id",
      "case_id",
      "condition_code",
      "match_root",
      "innings",
      "field_order",
      "gold",
      "legal_key_aliases"
    ]
  },
  "scoring": "all fields exact after explicit alias normalization; integers compare by integer value; missing/conflicting aliases are unexecutable"
}
