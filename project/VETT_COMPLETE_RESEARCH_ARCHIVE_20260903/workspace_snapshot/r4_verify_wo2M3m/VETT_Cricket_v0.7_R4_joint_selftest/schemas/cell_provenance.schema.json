{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vett-cricket.org/schema/cell-provenance-v1.json",
  "title": "VETT-Cricket cell provenance",
  "type": "object",
  "required": [
    "cell_id",
    "support_type",
    "evidence_spans",
    "dependencies",
    "derivation",
    "adjudication_status"
  ],
  "properties": {
    "cell_id": {"type": "string"},
    "support_type": {
      "enum": [
        "DIRECT",
        "DERIVED_LOCAL",
        "DERIVED_GLOBAL",
        "TEXT_CONFLICT",
        "TABLE_CONFLICT",
        "TABLE_ONLY",
        "AMBIGUOUS",
        "NOT_APPLICABLE",
        "UNANNOTATED"
      ]
    },
    "evidence_spans": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["document_id", "start", "end", "quote_hash"],
        "properties": {
          "document_id": {"type": "string"},
          "start": {"type": "integer", "minimum": 0},
          "end": {"type": "integer", "minimum": 0},
          "quote_hash": {"type": "string"},
          "claim_status": {"enum": ["valid", "provisional", "retracted", "stale"]}
        },
        "additionalProperties": false
      }
    },
    "dependencies": {"type": "array", "items": {"type": "string"}},
    "derivation": {"type": ["string", "null"]},
    "scope": {"type": "object"},
    "version": {"type": ["integer", "null"]},
    "adjudication_status": {
      "enum": ["AUTO_CANDIDATE", "HUMAN_VERIFIED", "EXPERT_ADJUDICATED", "BLOCKED"]
    }
  },
  "additionalProperties": false
}
