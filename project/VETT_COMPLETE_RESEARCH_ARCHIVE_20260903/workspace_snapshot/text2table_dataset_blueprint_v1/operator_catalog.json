{
  "version": "1.0",
  "operators": [
    {
      "id": "surface_paraphrase",
      "capability": "linguistic_variation",
      "description": "Render the same supported fact through multiple discourse and lexical forms.",
      "min_tier": 0,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["render_family", "paraphrase_sibling_id"]
    },
    {
      "id": "entity_alias",
      "capability": "entity_resolution",
      "description": "Refer to one entity through names, roles, abbreviations and context-dependent aliases.",
      "min_tier": 1,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["entity_id", "alias_type"]
    },
    {
      "id": "duplicate_replay",
      "capability": "event_identity",
      "description": "Repeat an already mentioned event without creating a new canonical event.",
      "min_tier": 1,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["same_event_as", "mention_role"]
    },
    {
      "id": "out_of_scope_shadow",
      "capability": "scope_resolution",
      "description": "Insert a non-target event stream sharing entities, venue, topic or nearby time.",
      "min_tier": 1,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["scope_id", "target_scope"]
    },
    {
      "id": "temporal_shuffle",
      "capability": "canonical_ordering",
      "description": "Present mentions in arrival order rather than canonical event order.",
      "min_tier": 2,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["arrival_index", "canonical_index"]
    },
    {
      "id": "revision_chain",
      "capability": "non_monotonic_resolution",
      "description": "Create one or more provisional claims that are later revised or withdrawn.",
      "min_tier": 2,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["version_id", "revises", "status"]
    },
    {
      "id": "stale_reappearance",
      "capability": "version_precedence",
      "description": "Repeat an obsolete claim after a newer correction has appeared.",
      "min_tier": 2,
      "prerequisites": ["revision_chain"],
      "incompatible_with": [],
      "private_annotations": ["version_id", "stale_after"]
    },
    {
      "id": "indirect_revision_reference",
      "capability": "cross_mention_linking",
      "description": "Refer to the revised event through semantic or relational descriptions rather than an explicit event ID.",
      "min_tier": 3,
      "prerequisites": ["revision_chain"],
      "incompatible_with": [],
      "private_annotations": ["revision_target", "reference_chain"]
    },
    {
      "id": "source_reliability",
      "capability": "provenance_reasoning",
      "description": "Make claim acceptance conditional on source, context or evidence quality.",
      "min_tier": 2,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["source_id", "source_state", "acceptance_rule"]
    },
    {
      "id": "global_numeric_constraints",
      "capability": "global_consistency",
      "description": "Resolve locally ambiguous facts using overlapping totals or cross-table constraints.",
      "min_tier": 3,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["constraint_id", "constraint_scope", "solver_certificate"]
    },
    {
      "id": "event_merge_split",
      "capability": "event_granularity",
      "description": "Describe one event across multiple mentions or combine multiple events in one mention.",
      "min_tier": 2,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["mention_to_event_edges"]
    },
    {
      "id": "unit_conversion",
      "capability": "normalization",
      "description": "Express values in heterogeneous but convertible units or scales.",
      "min_tier": 2,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["source_unit", "canonical_unit", "conversion_rule"]
    },
    {
      "id": "latent_schema",
      "capability": "schema_induction",
      "description": "Require the system to infer tables, rows, columns or relations not explicitly enumerated.",
      "min_tier": 3,
      "prerequisites": [],
      "incompatible_with": ["fixed_schema_only"],
      "private_annotations": ["schema_family", "schema_derivation"]
    },
    {
      "id": "recursive_state",
      "capability": "long_horizon_state",
      "description": "Make the resolution of one event affect the evidence rule or state used for later events.",
      "min_tier": 4,
      "prerequisites": ["source_reliability", "temporal_shuffle"],
      "incompatible_with": [],
      "private_annotations": ["state_before", "state_after", "transition_rule"]
    },
    {
      "id": "counterfactual_pair",
      "capability": "causal_sensitivity",
      "description": "Create minimal pairs where one evidence change should alter a known subset of output cells.",
      "min_tier": 2,
      "prerequisites": [],
      "incompatible_with": [],
      "private_annotations": ["pair_id", "changed_evidence", "expected_cell_delta"]
    }
  ]
}
