{
  "contract_version": "VETT-R26-DIFFICULTY-LEDGER-1.0",
  "status": "FROZEN_FEATURE_DEFINITIONS",
  "privacy": "PRIVATE_ANALYSIS_ONLY",
  "source_release": "r26_authority_binding_pilot",
  "row_granularity": "one decision question",
  "expected_rows": 100,
  "expected_levels": {"L1": 20, "L2": 20, "L3": 20, "L4": 20, "L5": 20},
  "expected_scenario_families": 25,
  "axis_caps": {
    "identity_hops": 5,
    "isomorphic_distractors": 3,
    "authority_decisions": 1,
    "rejected_evidence_count": 4,
    "derivation_depth": 4,
    "operator_cost_sum": 24,
    "operator_interaction_count": 8,
    "temporal_depth": 2,
    "positive_evidence_count": 23,
    "evidence_document_count": 19,
    "evidence_edge_count": 37,
    "counterfactual_path_length": 9,
    "counterfactual_blast_radius": 9
  },
  "axis_definitions": {
    "binding_load": "mean(identity_hops/5, isomorphic_distractors/3)",
    "authority_conflict_load": "mean(authority_decisions/1, rejected_evidence_count/4)",
    "rule_reasoning_load": "mean(derivation_depth/4, operator_cost_sum/24, operator_interaction_count/8)",
    "temporal_load": "temporal_depth/2",
    "evidence_load": "mean(positive_evidence_count/23, evidence_document_count/19, evidence_edge_count/37)",
    "counterfactual_load": "mean(counterfactual_path_length/9, counterfactual_blast_radius/9)",
    "structural_load_index": "unweighted mean of the six axes; structural audit only, never a model-performance metric"
  },
  "feature_roles": {
    "controlled_private": [
      "level", "identity_hops", "isomorphic_distractors", "authority_decisions",
      "temporal_depth", "derivation_depth"
    ],
    "observed_private": [
      "positive_evidence_count", "rejected_evidence_count", "evidence_edge_count",
      "evidence_document_count", "evidence_dispersion", "operator_count",
      "operator_cost_sum", "operator_interaction_count", "required_fact_count",
      "rule_count", "counterfactual_path_length", "counterfactual_blast_radius",
      "counterfactual_changed_output_count"
    ],
    "audit_only_redundant": [
      "resolves_to_edge_count", "reject_edge_count", "global_coverage"
    ]
  },
  "acceptance": {
    "all_rows_reproduce_embedded_difficulty_vector": true,
    "level_and_family_balance": true,
    "all_axis_values_between_zero_and_one": true,
    "mean_structural_load_strictly_increases": true,
    "mean_evidence_load_nondecreasing": true,
    "public_level_leaks": 0,
    "exact_duplicate_rows": 0,
    "build_is_byte_reproducible": true
  },
  "interpretation_rules": [
    "No single feature is required to increase at every adjacent level.",
    "Axis crossover is allowed to preserve heterogeneous reasoning mechanisms.",
    "Structural load does not prove empirical model difficulty.",
    "Only valid strong-model runs under the frozen metric contract calibrate difficulty."
  ]
}
